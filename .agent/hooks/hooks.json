{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.agent/hooks/suggest-compact.js"],
            "timeout": 5
          }
        ],
        "description": "Suggest compaction from transcript pressure with session-scoped tool-count fallback"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.agent/hooks/pre-compact.js"]
          }
        ],
        "description": "Save STATE.md snapshot before context compaction"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.agent/hooks/session-end.js"]
          }
        ],
        "description": "Report durable-state presence and suggest knowledge compounding"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.agent/hooks/stop-check.js"],
            "timeout": 5
          }
        ],
        "description": "Inspect the bounded final assistant message for debug or sensitive-looking output"
      }
    ]
  }
}
