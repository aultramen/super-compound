{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:super-compound:schema:usage-receipt-v2",
  "title": "Attributed Usage Receipt v2",
  "type": "object",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "measuredValue": {
      "type": "object",
      "properties": {
        "status": { "enum": ["MEASURED", "UNKNOWN"] },
        "value": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["status", "value"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema": { "const": "usage_receipt_v2" },
    "contract_version": { "const": "2.0.0" },
    "receipt_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "bound_run_head_digest": { "$ref": "#/$defs/digest" },
    "workflow_route": {
      "enum": [
        "sc-init",
        "sc-status",
        "sc-geniusloop",
        "sc-explore",
        "sc-research",
        "sc-prd",
        "sc-plan",
        "sc-eval",
        "sc-go",
        "sc-work",
        "sc-debug",
        "sc-review",
        "sc-audit",
        "sc-compound",
        "sc-evolve",
        "sc-pause",
        "sc-launch",
        "sc-ui"
      ]
    },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "autonomy_profile": { "enum": ["INTERACTIVE", "BACKGROUND"] },
    "risk_profile": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "contributor": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["MAIN_AGENT", "CHILD_AGENT"] },
        "ref": { "$ref": "#/$defs/digest" }
      },
      "required": ["kind", "ref"],
      "additionalProperties": false
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "$ref": "#/$defs/measuredValue" },
        "output_tokens": { "$ref": "#/$defs/measuredValue" },
        "reasoning_tokens": { "$ref": "#/$defs/measuredValue" },
        "cached_input_tokens": { "$ref": "#/$defs/measuredValue" }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "status": { "enum": ["MEASURED", "UNKNOWN"] },
        "micro_units": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "billing_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "pricing_revision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "pricing_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "status",
        "micro_units",
        "billing_currency",
        "pricing_revision",
        "pricing_digest"
      ],
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "properties": {
        "status": { "enum": ["VERIFIED", "NOT_REQUIRED"] },
        "attestation_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": ["status", "attestation_digest"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": { "enum": ["PARTIAL", "COMPLETE"] },
        "receipt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attestation_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": ["status", "receipt_count", "attestation_digest"],
      "additionalProperties": false
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schema",
    "contract_version",
    "receipt_id",
    "run_id",
    "bound_run_head_digest",
    "workflow_route",
    "iteration",
    "attempt",
    "autonomy_profile",
    "risk_profile",
    "contributor",
    "token_usage",
    "cost",
    "reservation",
    "coverage",
    "recorded_at"
  ],
  "additionalProperties": false
}
