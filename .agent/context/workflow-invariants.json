{
  "schema": "workflow_invariants_v2",
  "routes": {
    "sc-init": {
      "authority": "context-orientation",
      "mutation": "requested-note-only",
      "evidenceSink": "requested codebase note or chat",
      "loopRuntimeRole": "ADVISORY",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["dynamic-public-route"],
      "workflowMarkers": ["read-only by default", "suggest updates", "unknown"],
      "contractMarkers": ["Read-only by default", "never config or source", "unknown"]
    },
    "sc-status": {
      "authority": "routing-only",
      "mutation": "read-only",
      "evidenceSink": "short dashboard",
      "loopRuntimeRole": "READ_ONLY",
      "writeClasses": [],
      "wizardPolicy": "NEVER",
      "requiredOperationGate": [],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["dynamic-public-route"],
      "workflowMarkers": ["without reading all issue bodies", "do not mutate Git state", "/sc-geniusloop"],
      "contractMarkers": ["without reading all issue bodies", "read-only Git state", "one exact"]
    },
    "sc-geniusloop": {
      "authority": "advisory-ideation",
      "mutation": "geniusloop-report-only",
      "evidenceSink": "docs/geniusloop/YYYY-MM-DD-<scope>.md",
      "loopRuntimeRole": "ADVISORY",
      "writeClasses": ["runtime_audit_write", "implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["sc-explore", "sc-prd", "sc-plan", "sc-ui", "sc-research", "sc-audit"],
      "workflowMarkers": ["Do not implement code", "dispatch Brain directly", "only permitted mutation"],
      "contractMarkers": ["Do not implement", "Beta/Alpha/Theta/Delta", "only permitted mutation"]
    },
    "sc-explore": {
      "authority": "approved-brd-business-authority",
      "mutation": "brd-or-isolated-prototype-only",
      "evidenceSink": "docs/brd/brd-<feature>.md",
      "loopRuntimeRole": "AUTHORITY",
      "writeClasses": ["authority_write", "implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["sc-research", "sc-prd", "sc-ui"],
      "workflowMarkers": ["canonical output is a BRD", "Before approval and `/sc-prd`", "non-production", "HIGH_INTERACTION"],
      "contractMarkers": ["BRD skeleton", "before approval and `/sc-prd`", "chat draft", "HIGH_INTERACTION"]
    },
    "sc-research": {
      "authority": "advisory-evidence-only",
      "mutation": "research-note-only",
      "evidenceSink": "docs/research/YYYY-MM-DD-<slug>.md",
      "loopRuntimeRole": "ADVISORY",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["sc-explore", "sc-prd", "sc-plan", "sc-audit", "sc-debug"],
      "workflowMarkers": ["advisory evidence", "Keep the workflow read-only", "OPEN-RESEARCH"],
      "contractMarkers": ["advisory", "Research-Note-Skeleton", "OPEN-RESEARCH"]
    },
    "sc-prd": {
      "authority": "approved-prd-product-authority",
      "mutation": "prd-only",
      "evidenceSink": "docs/prd/prd-<feature>.md",
      "loopRuntimeRole": "AUTHORITY",
      "writeClasses": ["authority_write"],
      "wizardPolicy": "NEVER",
      "requiredOperationGate": [],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["sc-research", "sc-explore", "sc-ui", "sc-plan"],
      "workflowMarkers": ["approved BRD", "Before approval and `/sc-plan`", "OPEN-RESEARCH", "experience_baseline_status"],
      "contractMarkers": ["approved BRD", "before approval and", "chat draft", "experience_baseline_status"]
    },
    "sc-plan": {
      "authority": "fsd-and-accepted-adr-implementation-authority",
      "mutation": "fsd-and-goal-pointers-only",
      "evidenceSink": "docs/fsd/fsd-<feature>.md",
      "loopRuntimeRole": "AUTHORITY",
      "writeClasses": ["authority_write"],
      "wizardPolicy": "NEVER",
      "requiredOperationGate": [],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["sc-research", "sc-explore", "sc-prd", "sc-ui", "sc-work"],
      "workflowMarkers": ["implementation authority", "OPEN", "do not checkout or mutate Git state", "READY_FOR_SLICE"],
      "contractMarkers": ["FSD is implementation authority", "Stop with `OPEN", "do not mutate Git state", "READY_FOR_SLICE"]
    },
    "sc-eval": {
      "authority": "verification-gate",
      "mutation": "eval-artifact-only",
      "evidenceSink": ".agent/evals/<feature>.md",
      "loopRuntimeRole": "AUTHORITY",
      "writeClasses": ["authority_write"],
      "wizardPolicy": "NEVER",
      "requiredOperationGate": [],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["caller", "sc-plan", "sc-debug", "sc-work"],
      "workflowMarkers": ["commit`, push, PR", ".agent/evals/", "must be saved"],
      "contractMarkers": ["commit/push/PR", ".agent/evals/", "must be durable"]
    },
    "sc-go": {
      "authority": "explicit-user-git-intent",
      "mutation": "preview-first-explicit-operation-only",
      "evidenceSink": "Git preview or PR template",
      "loopRuntimeRole": "EXTERNAL_DELIVERY",
      "writeClasses": ["implementation_write", "external_write"],
      "wizardPolicy": "BEFORE_EXTERNAL_WRITE",
      "requiredOperationGate": ["commit", "push", "pr"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["caller"],
      "workflowMarkers": ["explicit user intent", "fresh preview", "force-push"],
      "contractMarkers": ["explicit current user intent", "fresh preview", "force-push"]
    },
    "sc-work": {
      "authority": "approved-fsd-goal",
      "mutation": "goal-scoped-implementation",
      "evidenceSink": "implementation and verification evidence",
      "loopRuntimeRole": "IMPLEMENTATION",
      "writeClasses": ["authority_write", "implementation_write"],
      "wizardPolicy": "START_AND_RESUME",
      "requiredOperationGate": ["work", "source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["sc-explore", "sc-prd", "sc-plan", "sc-debug", "sc-review", "sc-audit", "sc-go", "sc-compound", "caller"],
      "workflowMarkers": ["approved FSD goal", "stop and report `OPEN", "verification evidence", "pinned contract version"],
      "contractMarkers": ["approved FSD goal", "Stop with `OPEN", "mapped verification", "pinned contract version"]
    },
    "sc-debug": {
      "authority": "reproduced-failure-scope",
      "mutation": "root-cause-fix-only",
      "evidenceSink": "docs/debug/YYYY-MM-DD-<slug>.md for non-trivial evidence",
      "loopRuntimeRole": "IMPLEMENTATION",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "BEFORE_FIX",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["sc-compound", "caller"],
      "workflowMarkers": ["root cause", "regression test", "docs/debug/"],
      "contractMarkers": ["root cause", "regression test", "docs/debug/"]
    },
    "sc-review": {
      "authority": "advisory-findings",
      "mutation": "read-only",
      "evidenceSink": "docs/reviews/YYYY-MM-DD-<scope>.md",
      "loopRuntimeRole": "READ_ONLY",
      "writeClasses": [],
      "wizardPolicy": "NEVER",
      "requiredOperationGate": [],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["sc-explore", "sc-prd", "sc-plan", "sc-debug", "sc-work", "sc-go"],
      "workflowMarkers": ["spec axis first", "strictly read-only", "Exact next owner"],
      "contractMarkers": ["Spec first", "strictly read-only", "approved fixes"]
    },
    "sc-audit": {
      "authority": "risk-and-readiness-gate",
      "mutation": "read-only",
      "evidenceSink": "docs/audits/YYYY-MM-DD-<scope>.md",
      "loopRuntimeRole": "READ_ONLY",
      "writeClasses": [],
      "wizardPolicy": "NEVER",
      "requiredOperationGate": [],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["sc-explore", "sc-prd", "sc-plan", "sc-debug", "sc-work", "sc-go"],
      "workflowMarkers": ["strictly read-only", "Route remediation", "docs/audits/"],
      "contractMarkers": ["strictly read-only", "never apply fixes", "docs/audits/"]
    },
    "sc-compound": {
      "authority": "verified-knowledge",
      "mutation": "solution-note-only",
      "evidenceSink": "docs/solutions/<category>/",
      "loopRuntimeRole": "ADVISORY",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["caller"],
      "workflowMarkers": ["actually solved with evidence", "docs/solutions/", "Skip"],
      "contractMarkers": ["verified non-trivial solution", "docs/solutions/", "root cause"]
    },
    "sc-evolve": {
      "authority": "advisory-proposals",
      "mutation": "proposal-draft-only",
      "evidenceSink": "docs/proposals/",
      "loopRuntimeRole": "ADVISORY",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "READ_ONLY",
      "nextOwners": ["caller"],
      "workflowMarkers": ["DRAFT proposal", "docs/proposals/", "Skip"],
      "contractMarkers": ["DRAFT proposals", "docs/proposals/", "human approval"]
    },
    "sc-pause": {
      "authority": "handoff-state-only",
      "mutation": "canonical-state-pointer-and-optional-progress-note",
      "evidenceSink": "docs/STATE.md plus .continue-here.md short pointer",
      "loopRuntimeRole": "ORCHESTRATION",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "WHEN_IMPLEMENTATION_WRITE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["sc-status"],
      "workflowMarkers": ["do not mutate Git state", "docs/STATE.md", "short pointer"],
      "contractMarkers": ["before stopping", "docs/STATE.md", "short pointer"]
    },
    "sc-launch": {
      "authority": "orchestration-only",
      "mutation": "stage-authority-only",
      "evidenceSink": "stage artifact paths plus docs/STATE.md boundary state",
      "loopRuntimeRole": "ORCHESTRATION",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "PER_IMPLEMENTATION_HANDOFF",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["stage-next-route"],
      "workflowMarkers": ["one active stage at a time", "docs/STATE.md", "Do not treat launch as permission", "first vertical slice"],
      "contractMarkers": ["one active stage at a time", "docs/STATE.md", "grants no", "first vertical slice"]
    },
    "sc-ui": {
      "authority": "approved-fsd-goal-or-read-only-review",
      "mutation": "implementation-under-sc-work-only",
      "evidenceSink": "read-only UI evidence or sc-work-owned implementation verification",
      "loopRuntimeRole": "GUIDANCE",
      "writeClasses": ["implementation_write"],
      "wizardPolicy": "CONSUME_ACTIVE_WORK_GATE",
      "requiredOperationGate": ["source-write"],
      "loopStateAccess": "CONTROLLER_MEDIATED",
      "nextOwners": ["sc-explore", "sc-prd", "sc-plan", "sc-work", "caller"],
      "workflowMarkers": ["approved FSD `GOAL", "remains with `/sc-work`", "Design/review mode is read-only", "PRD_CHANGE_REQUIRED"],
      "contractMarkers": ["approved FSD `GOAL", "inside active `/sc-work`", "design/review mode is read-only", "PRD_CHANGE_REQUIRED"]
    }
  }
}
